.{
    .name = .wuffs,
    .version = "0.0.0",
    .fingerprint = 0x67c0c059de921c4f,
    .dependencies = .{
        .translate_c = .{
            .lazy = true,
            .url = "https://codeberg.org/vancluever/translate-c/archive/4e879eb8aba615de112eabd1231ea6e01920cead.tar.gz",
            .hash = "translate_c-0.0.0-Q_BUWhVNBwDOEcIqub4VFPJPB6D9dgwzUMHTX5KWr8Xr",
        },

        // google/wuffs
        //
        // Vendored locally as `./upstream` (only `release/c/wuffs-v0.4.c`, the
        // single amalgamation file this package actually compiles) instead of
        // fetching the full upstream tarball. The tarball ships deliberately
        // malformed image fixtures under `test/` that an on-access antivirus
        // (Bitdefender) flags and blocks reads of, breaking the build. None of
        // those fixtures are used here. See vendor_libghostty_vt.py, which
        // re-applies this on every re-vendor.
        .wuffs = .{
            .path = "upstream",
        },

        // make-github-pseudonymous-again/pixels
        .pixels = .{
            .url = "https://deps.files.ghostty.org/pixels-12207ff340169c7d40c570b4b6a97db614fe47e0d83b5801a932dcd44917424c8806.tar.gz",
            .hash = "N-V-__8AADYiAAB_80AWnH1AxXC0tql9thT-R-DYO1gBqTLc",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "include",
        "src",
    },
}
